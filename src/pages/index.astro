
---
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";

const nome = "Gustavo Nogueira";
const especialidade = "AI Automation & Integrations";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{nome} | AI Automation Lab</title>
  </head>
  
  <body>
    <Header />
    <main>
      <p>Hello, I'm</p>
      <h1>{nome}</h1>
      <h2>{especialidade}</h2>

      <p>
        Developing smart automizations ,
		AI Agents and System integrations.
	  <h2>WELCOME TO MY AI AUTOMATION LAB</h2>
      </p>
	  <p> Curently Studying Python and AI Engineering!!! </p>
      <a href="https://github.com/gustavodeonogueira">
         See my GitHub profile
      </a>
	  
		<section class="projetos">
		<h2>Projects and Real Cases</h2>

		
		<ProjectCard
		title="AI Smart Scheduling"
		description="AI-powered appointment scheduling with n8n and Google Calendar."
		/>

		<ProjectCard
		title="WhatsApp AI Customer Service"
		description="AI-powered customer service with WhatsApp, Evolution API, and n8n."
		/>

		<ProjectCard
		title="AI Workflow Reliability"
		description="Improving AI workflow reliability through loop prevention and error handling."
		/>
		</section>

    	</main>
  		</body>
		</html>

<style>
  body {
    background: #101018;
    color: #f5f5f5;
    font-family: Arial, sans-serif;
    margin: 0;
  }

  main {
    max-width: 800px;
    margin: 120px auto;
    padding: 24px;
  }

  h1 {
    font-size: 56px;
    margin-bottom: 8px;
  }

  h2 {
    color: #00d4ff;
  }

  p {
    line-height: 1.8;
  }

  a {
    color: #b28cff;
  }

.projetos {
  margin-top: 80px;
}

</style>
